<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="fr-FR">
  <info>
    <title>Précis socio-fiscal tunisien</title>
    <id>https://github.com/benjello/precis-socio-fiscal-tunisie/precis.csl</id>
    <category citation-format="author-date"/>
    <updated>2026-10-08T00:00:00+00:00</updated>
  </info>
  <!-- Terme propre au précis, décliné par langue : le même style sert les deux éditions,
       et CSL n'a pas de terme standard pour « adresse d'origine ». -->
  <locale xml:lang="fr">
    <terms><term name="archive-original">adresse d’origine</term></terms>
  </locale>
  <locale xml:lang="ar">
    <terms><term name="archive-original">العنوان الأصلي</term></terms>
  </locale>
  <macro name="designation">
    <choose>
      <!-- Une forme courte explicite prime TOUJOURS, quel que soit le type : elle a été
           écrite ou dérivée pour être lue dans le fil de la phrase. -->
      <if variable="title-short">
        <text variable="title-short"/>
      </if>
      <!-- Sinon un auteur, qui donne la forme usuelle « Auteur année ». -->
      <else-if variable="author">
        <names variable="author"><name form="short" and="text"/></names>
        <date variable="issued" prefix=" "><date-part name="year"/></date>
      </else-if>
      <!-- En dernier recours le titre entier : long, mais jamais faux. -->
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <citation disambiguate-add-year-suffix="false" disambiguate-add-names="false">
    <layout prefix="(" suffix=")" delimiter="&#160;; ">
      <group delimiter=", ">
        <text macro="designation"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <!-- Une œuvre signée se classe et se lit à ses auteurs ; un texte de droit, à son intitulé. -->
  <macro name="classement">
    <choose>
      <if variable="author">
        <names variable="author"><name name-as-sort-order="all" sort-separator=" "/></names>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>
  <macro name="auteurs">
    <choose>
      <if variable="author">
        <group delimiter=" ">
          <names variable="author"><name and="text" delimiter-precedes-last="never"/></names>
          <date variable="issued" prefix="(" suffix=")"><date-part name="year"/></date>
        </group>
      </if>
    </choose>
  </macro>
  <bibliography>
    <sort><key macro="classement"/><key variable="title"/></sort>
    <layout suffix=".">
      <group delimiter=", ">
        <text macro="auteurs"/>
        <text variable="title"/>
        <text variable="container-title"/>
        <text variable="issue" prefix="n° "/>
        <text variable="page" prefix="p. "/>
      </group>
      <text variable="URL" prefix=" "/>
      <!-- Document tiré des archives du web : `URL` est la capture ; on dit où elle a été
           prise et quelle était l'adresse d'origine. Rien ne s'affiche sans `archive`. -->
      <group prefix=" [" suffix="]" delimiter=", ">
        <text variable="archive"/>
        <group delimiter=" : ">
          <text term="archive-original"/>
          <text variable="archive_location"/>
        </group>
      </group>
    </layout>
  </bibliography>
</style>
